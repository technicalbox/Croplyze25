rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read and write their own profile data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can manage their own crop diagnoses.
    match /users/{userId}/cropDiagnoses/{diagnosisId} {
      allow read, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Users can manage their own farming plans (Farming Partner Engine).
    match /users/{userId}/farming-plans/{planId} {
      allow read, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Users can manage their own Crop Success Planner results.
    match /users/{userId}/crop-success-plans/{planId} {
      allow read, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Users can manage their own Growth Timelines.
    match /users/{userId}/growth-timelines/{timelineId} {
      allow read, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Users can manage their own Harvest Optimizer reports.
    match /users/{userId}/harvest-optimizer/{reportId} {
      allow read, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Users can manage their own Farming Chatbot sessions and messages.
    match /users/{userId}/chat-sessions/{sessionId} {
      allow read, list, create, update, delete: if request.auth != null && request.auth.uid == userId;

      match /messages/{messageId} {
        allow read, list, create: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Users can manage their own preferences (favorites, settings, etc.)
    match /users/{userId}/preferences/{prefId} {
      allow read, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Users can manage their own Profit Predictor calculations.
    match /users/{userId}/profitCalculations/{calcId} {
      allow read, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Users can manage their own Crop Comparison history.
    match /users/{userId}/cropComparisons/{compareId} {
      allow read, list, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Public read access to the master crop intelligence database.
    match /crops/{cropId} {
      allow read, list: if true; 
    }
  }
}
